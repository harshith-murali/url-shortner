# ─── Sniply — Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local with real credentials.

# ─── MongoDB (REQUIRED) ────────────────────────────────────────────────────
# Get a free Atlas cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/sniply

# ─── Clerk Authentication (REQUIRED) ──────────────────────────────────────
# Create a free app at https://clerk.com → Settings → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routing (keep these as-is unless you rename the pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── App Base URL (REQUIRED in production) ────────────────────────────────
# Used to construct short URLs.  Set to your Vercel / custom domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Rate Limiting — Upstash Redis (OPTIONAL but RECOMMENDED in production) ─
# Without these variables the app falls back to an in-memory rate limiter
# that is NOT suitable for production (per-process, lost on restart).
# Get free Redis at https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Rate limit thresholds (requests per minute — defaults shown)
# RATE_LIMIT_ANON=10
# RATE_LIMIT_AUTHED=30
